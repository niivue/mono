{
  "name": "@niivue/uikit",
  "version": "1.0.0-rc.243",
  "private": false,
  "type": "module",
  "description": "UIKit: controls and widgets integrated into the NiiVue rendering lifecycle",
  "license": "BSD-2-Clause",
  "author": "niivue authors",
  "homepage": "https://github.com/niivue/niivue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niivue/niivue.git"
  },
  "bugs": {
    "url": "https://github.com/niivue/niivue/issues"
  },
  "keywords": [
    "niivue",
    "webgpu",
    "webgl",
    "medical-imaging",
    "visualization",
    "overlay",
    "annotation"
  ],
  "main": "./dist/uikit.js",
  "module": "./dist/uikit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/uikit.js"
    },
    "./controls": {
      "types": "./dist/controlsEntry.d.ts",
      "import": "./dist/controls.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx --bun vite build",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "check:standalone": "bun scripts/standalone-check.ts"
  },
  "peerDependencies": {
    "@webgpu/types": ">=0.1.69"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^4.5.4"
  },
  "sideEffects": false
}
