{
  "name": "docs-site",
  "projectType": "application",
  "tags": ["type:app", "lang:typescript"],
  "targets": {
    "dev": {
      "command": "bunx docusaurus start",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"]
    },
    "build": {
      "command": "bunx docusaurus build --out-dir dist",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"],
      "inputs": [
        "typescript",
        "{projectRoot}/**/*",
        "!{projectRoot}/dist/**/*",
        "!{projectRoot}/.docusaurus/**/*",
        "{workspaceRoot}/packages/niivue/examples/**/*",
        "{workspaceRoot}/nx-tools/repo-graph.ts",
        { "env": "DOCS_BASE_URL" },
        { "env": "DOCS_EXAMPLES_BASE" }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "command": "bunx tsc --noEmit",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"],
      "inputs": ["typescript"]
    },
    "lint": {
      "command": "bunx biome check {projectRoot}",
      "inputs": ["lintable"]
    },
    "format": {
      "command": "bunx biome format {projectRoot} --write",
      "inputs": ["lintable"]
    }
  }
}
