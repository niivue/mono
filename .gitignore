# ipyniivue: bundled widget JS (~1.3 MB) is auto-generated by codegen.
# Run `bunx nx codegen ipyniivue` to (re)build it. Smaller reviewable
# codegen outputs (`_widget.template.js`, `_generated.py`,
# `api.generated.json`) stay committed as a code-review surface.
packages/ipyniivue/src/ipyniivue/static/widget.js

.claude/worktrees
.claude/settings.local.json

# OS junk
.DS_Store

# Per-developer AI tooling configs (generated by nrwl/nx-ai-agents-config etc.)
.agents/
.codex/
.opencode/
opencode.json
.github/agents/
.github/prompts/
.github/skills/

# Transient audit scratch/response files (see the /audit workflow).
audit_*.md

# Local perf report (generated by bench tooling)
packages/niivue/perf-report.html

# Generated self-contained niivue bundle (built by prebuild:standalone, fetched
# at runtime by the save-html demo; regenerated on dev/build).
apps/demo-ext-save-html/public/niivue-standalone.js

# On-demand OME-Zarr fixtures for demo-ext-tile's range.html. Multi-GB,
# downloaded by apps/demo-ext-tile/scripts/fetch-omezarr.ts. The small `stent`
# store is bundled (tracked); every other store is ignored.
apps/demo-ext-tile/public/omezarr/*.ome.zarr/
!apps/demo-ext-tile/public/omezarr/stent.ome.zarr/
apps/demo-ext-tile/public/range-poc/

# DICOM-WSI fixtures for the slides.html tile viewer. Hundreds of MB per series,
# downloaded + manifest-generated on demand by scripts/fetch-dicom-wsi.ts.
packages/niivue/public/dicom-wsi/
packages/niivue/public/svs/

# Synthetic POC fixtures for the range.html / slides.html streaming demos.
# Deterministically generated on demand by scripts/generate-range-poc-fixture.ts
# and scripts/generate-tile-range-poc-fixture.ts (run by `gen-fixtures`, which
# the dev/build:examples/deploy scripts invoke). Never committed.
packages/niivue/public/range-poc/
packages/niivue/public/tile-range-poc/

# Large generated POC / fixture data for the iiif-volumetric demo (OME-Zarr
# chunks, tile range probes). Multi-GB, regenerated locally — never committed.
apps/iiif-volumetric-demo/public/range-poc/
apps/iiif-volumetric-demo/public/tile-range-poc/

# Local scratch: plans, notes, throwaway files. Never checked in.
/scratch/

# nv-ohif builds to lib/ (OHIF copies a plugin's dist/ into its site root).
packages/nv-ohif/lib/
