---
// Stills of each kind of data NiiVue shows, drawn by NiiVue itself
// (scripts/home-stills.ts). Each links to where the docs cover it.
import { withBase } from '../site'

const STILLS = [
  {
    label: 'MRI',
    image: 'mri',
    alt: 'A T1-weighted MRI of a head, cut down the middle',
    href: 'guide/loading/',
  },
  {
    label: 'CT',
    image: 'ct',
    alt: 'A 3D rendering of a skull from a CT scan',
    href: 'gallery/vox-ct/',
  },
  {
    label: 'Microscopy',
    image: 'microscopy',
    alt: 'Stained skin tissue in a whole-slide microscope image',
    href: 'packages/nv-ext-tile/',
  },
  {
    label: 'Surfaces',
    image: 'surfaces',
    alt: 'A brain surface with motor activity mapped onto it',
    href: 'guide/meshes/',
  },
  {
    label: 'Tractography',
    image: 'tractography',
    alt: 'White matter fibers colored by direction',
    href: 'guide/tracts/',
  },
]
---

<ul class="strip" aria-label="Some of what NiiVue shows">
  {
    STILLS.map(({ label, image, alt, href }) => (
      <li>
        <a href={withBase(href)}>
          <img
            src={withBase(`img/home/${image}.webp`)}
            alt={alt}
            width="640"
            height="640"
            decoding="async"
          />
          <span>{label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(9.5rem, 42%);
    gap: 0.75rem;
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  li {
    scroll-snap-align: start;
  }

  a {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--nv-viewer);
    border: 1px solid var(--nv-viewer-line);
    border-radius: var(--nv-radius);
    transition: border-color 0.2s ease;
  }

  a:hover {
    border-color: var(--sl-color-gray-4);
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  a:hover img {
    transform: scale(1.04);
  }

  /* The label sits on a soft shade, so it reads on bright images too. */
  span {
    position: absolute;
    inset: auto 0 0;
    padding: 2.25rem 0.85rem 0.7rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
  }

  @media (min-width: 50rem) {
    .strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
      padding: 0;
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }

    a:hover img {
      transform: none;
    }
  }
</style>
