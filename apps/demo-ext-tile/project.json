{
  "name": "demo-ext-tile",
  "projectType": "application",
  "tags": ["type:app", "lang:typescript"],
  "targets": {
    "dev": {
      "command": "bun scripts/generate-range-poc-fixture.ts && bunx --bun vite --open /index.html",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "command": "bun scripts/generate-range-poc-fixture.ts && bunx --bun vite build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": [
        "typescript",
        "bundledDeps",
        "{projectRoot}/vite.config.js",
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/public/**/*",
        "{projectRoot}/*.html",
        {
          "env": "VITE_BASE"
        },
        {
          "env": "VITE_OMEZARR_ASSET_BASE"
        },
        {
          "env": "VITE_STREAMING_ASSET_BASE"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "e2e": {
      "command": "node tests/folder.e2e.mjs && node tests/viewer.e2e.mjs && node tests/omezarr-time.e2e.mjs && node tests/zarr-slide.e2e.mjs",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"],
      "inputs": [
        "typescript",
        "^typescript",
        "{projectRoot}/tests/**/*",
        "{workspaceRoot}/packages/nv-ext-tile/fixtures/zarr-variants/**/*"
      ]
    },
    "bench": {
      "command": "node bench/run.mjs",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "command": "bun test",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": ["typescript"]
    },
    "typecheck": {
      "command": "bunx tsc --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": ["typescript"]
    },
    "lint": {
      "command": "bunx biome check {projectRoot}",
      "inputs": ["lintable"]
    },
    "format": {
      "command": "bunx biome format {projectRoot} --write",
      "inputs": ["lintable"]
    }
  }
}
