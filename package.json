{
  "name": "niivue-mono",
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@nx/js": "^22.6.3",
    "@types/bun": "^1.4.0",
    "http-server": "^14.1.1",
    "knip": "6.39.0",
    "nx": "22.6.3"
  },
  "private": true,
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
