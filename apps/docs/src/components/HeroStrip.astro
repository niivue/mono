---
// Stills of each kind of data NiiVue shows, drawn by NiiVue itself
// (scripts/home-stills.ts).
import { withBase } from '../site'

const STILLS = [
  {
    label: 'MRI',
    image: 'mri',
    alt: 'A T1-weighted MRI of a head, cut down the middle',
  },
  {
    label: 'CT',
    image: 'ct',
    alt: 'A 3D rendering of a skull from a CT scan',
  },
  {
    label: 'Microscopy',
    image: 'microscopy',
    alt: 'Stained skin tissue in a whole-slide microscope image',
  },
  {
    label: 'Surfaces',
    image: 'surfaces',
    alt: 'A brain surface with motor activity mapped onto it',
  },
  {
    label: 'Tractography',
    image: 'tractography',
    alt: 'White matter fibers colored by direction',
  },
]
---

<ul class="strip" aria-label="Some of what NiiVue shows">
  {
    STILLS.map(({ label, image, alt }) => (
      <li>
        <figure>
          <img
            src={withBase(`img/home/${image}.webp`)}
            alt={alt}
            width="640"
            height="640"
            decoding="async"
          />
          <figcaption>{label}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  /* Five across on a wide screen; narrower, three over two (two per row on
     the smallest phones), always centered so a short row looks intended. */
  .strip {
    --gap: 0.75rem;
    --per-row: 3;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    flex: 0 0
      calc((100% - (var(--per-row) - 1) * var(--gap)) / var(--per-row));
  }

  figure {
    position: relative;
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--nv-viewer);
    border: 1px solid var(--nv-viewer-line);
    border-radius: var(--nv-radius);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The label sits on a soft shade, so it reads on bright images too. */
  figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 1.75rem 0.6rem 0.5rem;
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
  }

  @media (max-width: 22.5rem) {
    .strip {
      --per-row: 2;
    }
  }

  @media (min-width: 50rem) {
    .strip {
      --gap: 1rem;
      --per-row: 5;
    }

    figcaption {
      padding: 2.25rem 0.85rem 0.7rem;
      font-size: var(--sl-text-sm);
    }
  }
</style>
