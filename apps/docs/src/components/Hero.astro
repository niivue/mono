---
// The home page's first screen: Starlight's hero text and actions on a black
// panel, over a row of NiiVue stills. Only the home page sets `hero`.
import { LinkButton } from '@astrojs/starlight/components'
import HeroBackdrop from './HeroBackdrop.astro'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero ?? {}
---

<div class="hero">
  <HeroBackdrop />
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    <div class="actions">
      {
        actions.map(({ link, text, variant }) =>
          variant === 'primary' ? (
            <LinkButton href={link}>{text}</LinkButton>
          ) : (
            <a class="text-link" href={link}>
              {text} &rarr;
            </a>
          ),
        )
      }
    </div>
  </div>
</div>

<style>
  /* The panel is black in both themes, so it uses the dark theme's text and
     accent colors (the primary button reads them too). */
  .hero {
    --sl-color-white: #fafafa;
    --sl-color-black: #0a0a0a;
    --sl-color-gray-3: #c8c8c8;
    --sl-color-text-accent: #e07a84;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block: 1.5rem 1rem;
    padding: clamp(1.75rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem);
    background: var(--nv-viewer);
    border-radius: var(--nv-radius);
  }

  /* A shade under the text: dark where the text is, clear where it is not. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0.8) 0%,
      rgb(0 0 0 / 0.72) 38%,
      rgb(0 0 0 / 0.25) 66%,
      rgb(0 0 0 / 0) 84%
    );
  }

  .copy {
    position: relative;
    z-index: 2;
    max-width: 34rem;
  }

  /* Keeps the text crisp where an image shows through the shade. */
  h1,
  .tagline {
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.85);
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(var(--sl-text-3xl), calc(1rem + 3vw), var(--sl-text-5xl));
    line-height: 1.1;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .tagline {
    max-width: 36rem;
    margin-top: 1rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-top: 1.75rem;
  }

  .actions :global(.sl-link-button) {
    margin: 0;
  }

  .text-link {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  /* Narrow screens: the text on top and the row of stills below it, each a
     fifth of the panel's width (a percentage padding is of the width too). */
  @media (max-width: 50rem) {
    .hero {
      padding-bottom: calc(20% + 1.5rem);
    }

    .hero::before {
      background: none;
    }
  }
</style>
