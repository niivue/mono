{
  "name": "@niivue/nv-mcp",
  "version": "1.0.0-rc.0",
  "type": "module",
  "description": "An MCP server for a NiiVue page: an agent drives the crosshair, clip plane, camera, volumes and atlas regions of whatever a person is looking at",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@niivue/niivue": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@niivue/niivue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "scripts": {
    "build": "bunx --bun vite build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
