{
  "name": "docs-site",
  "projectType": "application",
  "tags": ["type:app", "lang:typescript"],
  "targets": {
    "dev": {
      "command": "bunx astro dev",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "command": "bunx astro build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": [
        "typescript",
        "bundledDeps",
        "{projectRoot}/**/*",
        "!{projectRoot}/dist/**/*",
        "!{projectRoot}/.astro/**/*",
        "{workspaceRoot}/packages/niivue/examples/**/*",
        "{workspaceRoot}/packages/*/docs/**/*",
        "{workspaceRoot}/.github/pages/index.html",
        "{workspaceRoot}/apps/*/*.html",
        "{workspaceRoot}/apps/*/src/**/*",
        "{workspaceRoot}/nx-tools/repo-graph.ts",
        {
          "env": "DOCS_BASE_URL"
        },
        {
          "env": "DOCS_EXAMPLES_BASE"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "command": "bunx astro check",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": ["typescript", "{projectRoot}/**/*.astro"]
    },
    "lint": {
      "command": "bunx biome check {projectRoot}",
      "inputs": ["lintable", "{projectRoot}/**/*.astro"]
    },
    "format": {
      "command": "bunx biome format {projectRoot} --write",
      "inputs": ["lintable", "{projectRoot}/**/*.astro"]
    },
    "screenshots": {
      "command": "bun scripts/screenshots.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "home-stills": {
      "command": "bun scripts/home-stills.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
