{
  "name": "nv-ext-tile",
  "projectType": "library",
  "tags": ["type:lib", "lang:typescript"],
  "targets": {
    "build": {
      "command": "bunx --bun vite build && bunx --bun vite build -c vite.config.standalone.ts && bun scripts/check-standalone.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": [
        "typescript",
        "{projectRoot}/vite.config.ts",
        "{projectRoot}/vite.config.standalone.ts",
        "{projectRoot}/scripts/check-standalone.ts",
        "{projectRoot}/src/**/*",
        "{workspaceRoot}/packages/niivue/src/**/*"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "command": "bun test",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": ["typescript", "{projectRoot}/fixtures/zarr-variants/**/*"],
      "dependsOn": ["^build"]
    },
    "e2e": {
      "command": "node tests/standalone.e2e.mjs",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build", "^build"],
      "inputs": [
        "typescript",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/fixtures/standalone/**/*",
        "{projectRoot}/fixtures/dicom-wsi/**/*",
        "{workspaceRoot}/packages/niivue/src/**/*"
      ]
    },
    "typecheck": {
      "command": "bunx tsc --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": ["typescript"]
    },
    "lint": {
      "command": "bunx biome check {projectRoot}",
      "inputs": ["lintable"]
    },
    "format": {
      "command": "bunx biome format {projectRoot} --write",
      "inputs": ["lintable"]
    }
  }
}
