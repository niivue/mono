{
  "name": "demo-mcp",
  "projectType": "application",
  "tags": ["type:app", "lang:typescript"],
  "targets": {
    "server": {
      "command": "bun server/server.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "frontend": {
      "command": "bunx vite --open /index.html",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "dev": {
      "command": "bun server/dev.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "exploded-labels": {
      "command": "bun scripts/exploded-labels.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "command": "bunx --bun vite build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": [
        "typescript",
        "{projectRoot}/vite.config.ts",
        "{projectRoot}/src/**/*",
        "{projectRoot}/*.html"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "command": "bunx tsc --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": ["typescript"]
    },
    "lint": {
      "command": "bunx biome check {projectRoot}",
      "inputs": ["typescript"]
    },
    "format": {
      "command": "bunx biome format {projectRoot} --write",
      "inputs": ["typescript"]
    }
  }
}
