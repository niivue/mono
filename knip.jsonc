{
  "$schema": "https://unpkg.com/knip@6.39.0/schema-jsonc.json",
  "workspaces": {
    ".": {
      // Run manually, from workflows, or from nx.json (versionActions, changelog renderer).
      "entry": [
        ".github/scripts/*.ts",
        "nx-tools/*.{js,ts}",
        "apps/medgfx/scripts/*.ts"
      ],
      // .github/build-pages.sh --serve runs it; Knip does not read shell scripts.
      "ignoreDependencies": ["http-server"]
    },
    "apps/demo-ext-tile": {
      "entry": ["scripts/*.ts"]
    },
    "apps/docs": {
      // Demo.astro loads the demos by name through import.meta.glob; Starlight
      // loads routeData.ts from its `routeMiddleware` path; the guides in
      // packages/niivue/docs import Demo.astro through the `@site` alias.
      "entry": [
        "src/demos/*.ts",
        "src/routeData.ts",
        "src/components/Demo.astro"
      ],
      // `astro check` (project.json typecheck) loads it; Knip does not read project.json.
      "ignoreDependencies": ["@astrojs/check"]
    },
    "apps/iiif-volumetric-demo": {
      "entry": ["src/**/*.test.ts"]
    },
    "apps/iiif-volumetric-server": {
      "entry": ["scripts/*.ts"]
    },
    // Bare `bun test` in project.json, which Knip doesn't read. Not a packages/* glob:
    // overriding `entry` drops Knip's src/index.ts default, nv-ohif's only public entry.
    "packages/dev-images": { "entry": ["src/**/*.test.ts"] },
    "packages/nv-ext-drawing": { "entry": ["src/**/*.test.ts"] },
    "packages/nv-ext-image-processing": { "entry": ["src/**/*.test.ts"] },
    "packages/nv-ext-isosurface": { "entry": ["src/**/*.test.ts"] },
    "packages/nv-ext-save-html": { "entry": ["src/**/*.test.ts"] },
    "packages/ipyniivue": {
      // Reaches _widget.template.js, which imports the bundled @niivue/* devDependencies.
      "entry": ["tests/**/*.test.ts"]
    },
    "packages/nv-ext-tile": {
      "entry": ["scripts/*.ts"]
    },
    "packages/nv-react": {
      // build:lib bundles src/lib.ts (exports point at dist/types, which Knip can't map back).
      "entry": ["src/lib.ts!", "src/**/*.test.{ts,tsx}"]
    },
    "packages/niivue": {
      // Public entries are kept explicit so a Knip plugin change cannot silently drop them (Knip
      // currently also finds src/index*.ts and hints they are redundant). Tests and tools stay reachable.
      "entry": [
        "src/index.ts!",
        "src/index.webgpu.ts!",
        "src/index.webgl2.ts!",
        "src/control/NVCanvasViewportController.ts!",
        "src/scene/NvSceneController.ts!",
        "src/assets/fonts/index.ts!",
        "src/assets/matcaps/index.ts!",
        "src/**/*.test.ts",
        "e2e/coverageGlobalSetup.ts",
        "examples/vox.worker.js",
        "scripts/check-blend-wgsl.mjs",
        "scripts/fetch-dicom-wsi.ts",
        "scripts/fetch-openslide-dicom.ts",
        "bench/build-report.ts",
        "bench/compare-bench.ts",
        "benchmarks/diff-runs.mjs"
      ],
      // The trailing ! marks production patterns; test exclusions apply only there.
      "project": [
        "**/*.{js,mjs,ts,tsx}!",
        "!src/**/*.test.ts!",
        "!src/volume/tiffBuilders.ts!"
      ],
      // Reader/writer modules are consumed through `import * as` maps in `_registry.ts`
      // (including the optional `isCurv` hook), which Knip can't trace. Types stay reported.
      // NVCanvasViewportController keeps its named and default export (deprecated
      // API, outside the dependency cleanup: plan decision 5).
      "ignoreIssues": {
        "src/**/{readers,writers}/*.ts": ["exports"],
        "src/control/NVCanvasViewportController.ts": ["duplicates"]
      },
      // Playwright loads Vite browser URLs inside page.evaluate.
      "paths": {
        "/src/*": ["./src/*"]
      }
    }
  }
}
