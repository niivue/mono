---
// The home page's first screen: Starlight's hero text and actions, and a strip
// of NiiVue stills in place of the hero image. Only the home page sets `hero`.
import { LinkButton } from '@astrojs/starlight/components'
import HeroStrip from './HeroStrip.astro'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero ?? {}
---

<div class="hero">
  <h1 id="_top" data-page-title set:html={title} />
  {tagline && <p class="tagline" set:html={tagline} />}
  <div class="actions">
    {
      actions.map(({ link, text, variant }) =>
        variant === 'primary' ? (
          <LinkButton href={link}>{text}</LinkButton>
        ) : (
          <a class="text-link" href={link}>
            {text} &rarr;
          </a>
        ),
      )
    }
  </div>
  <HeroStrip />
</div>

<style>
  .hero {
    padding-block: 2.5rem 1rem;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(var(--sl-text-3xl), calc(1rem + 3vw), var(--sl-text-5xl));
    line-height: 1.1;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .tagline {
    max-width: 36rem;
    margin-top: 1rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-block: 1.75rem 2.5rem;
  }

  .actions :global(.sl-link-button) {
    margin: 0;
  }

  .text-link {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }
</style>
