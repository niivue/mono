<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Debug loads the web app from the Vite dev server on localhost:8083.
	     Without this a sandboxed Debug build sits on "Waiting for webview..."
	     forever. Release bundles everything and does not need it, but leaving
	     it on is harmless. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
