{
  "name": "neurovue",
  "projectType": "application",
  "tags": ["type:app", "lang:typescript"],
  "targets": {
    "dev": {
      "command": "bunx --bun vite --host 127.0.0.1 --port 5175 --strictPort",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"]
    },
    "build": {
      "command": "bunx --bun vite build",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"],
      "inputs": [
        "typescript",
        "{projectRoot}/vite.config.ts",
        "{projectRoot}/src/**/*",
        "{projectRoot}/*.html"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "command": "bunx tsc --noEmit",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"],
      "inputs": ["typescript"]
    },
    "tauri-dev": {
      "command": "bunx tauri dev",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"]
    },
    "tauri-build": {
      "command": "bunx tauri build",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["^build"]
    },
    "lint": {
      "command": "bunx biome check {projectRoot}",
      "inputs": ["lintable"]
    },
    "format": {
      "command": "bunx biome format {projectRoot} --write",
      "inputs": ["lintable"]
    }
  }
}
