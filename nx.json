{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "typescript": [
      "{projectRoot}/**/*.ts",
      "{projectRoot}/**/*.tsx",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/package.json"
    ],
    "lintable": [
      "{projectRoot}/**/*.ts",
      "{projectRoot}/**/*.tsx",
      "{projectRoot}/**/*.js",
      "{projectRoot}/**/*.jsx",
      "{projectRoot}/**/*.mjs",
      "{projectRoot}/**/*.cjs",
      "{projectRoot}/**/*.html",
      "{projectRoot}/**/*.json",
      "{projectRoot}/**/*.jsonc",
      "{projectRoot}/**/*.css",
      "{workspaceRoot}/biome.json"
    ],
    "python": ["{projectRoot}/**/*.py", "{projectRoot}/pyproject.toml"]
  },
  "targetDefaults": {
    "dev": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "format": {
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true
    },
    "test": {
      "cache": true
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@nx/js:release-publish": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "release": {
    "releaseTag": {
      "strictPreid": false
    },
    "groups": {
      "typescript": {
        "projects": ["packages/niivue", "packages/nv-*", "packages/uikit"],
        "projectsRelationship": "independent",
        "releaseTag": {
          "pattern": "{projectName}@{version}"
        },
        "version": {
          "conventionalCommits": true,
          "fallbackCurrentVersionResolver": "disk",
          "updateDependents": "auto"
        },
        "changelog": true
      },
      "python": {
        "projects": ["packages/ipyniivue"],
        "projectsRelationship": "independent",
        "releaseTag": {
          "pattern": "{projectName}@{version}"
        },
        "version": {
          "conventionalCommits": true,
          "fallbackCurrentVersionResolver": "disk",
          "versionActions": "./nx-tools/pixi-version-actions.js"
        },
        "changelog": true
      }
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": false,
      "projectChangelogs": {
        "renderer": "{workspaceRoot}/nx-tools/plain-text-changelog-renderer.js"
      }
    },
    "conventionalCommits": {
      "types": {
        "feat": { "changelog": { "title": "Features" } },
        "fix": { "changelog": { "title": "Fixes" } },
        "perf": { "changelog": { "title": "Performance" } },
        "refactor": {
          "semverBump": "none",
          "changelog": { "title": "Refactors" }
        },
        "chore": { "semverBump": "none", "changelog": { "title": "Chores" } },
        "docs": {
          "semverBump": "none",
          "changelog": { "title": "Documentation" }
        },
        "build": { "semverBump": "none", "changelog": { "title": "Build" } },
        "types": { "semverBump": "none", "changelog": { "title": "Types" } },
        "examples": {
          "semverBump": "none",
          "changelog": { "title": "Examples" }
        },
        "test": { "semverBump": "none", "changelog": { "title": "Tests" } },
        "style": { "semverBump": "none", "changelog": { "title": "Styles" } },
        "ci": { "semverBump": "none", "changelog": { "title": "CI" } },
        "revert": { "semverBump": "none", "changelog": { "title": "Reverts" } }
      }
    }
  },
  "analytics": false
}
